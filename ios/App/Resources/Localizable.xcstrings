    "help.algorithms.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Math, waveforms, interpolation, easing, smoothing, hysteresis, edges, peak hold, deterministic random, noise, and 7-group patterns are available. Typed lists hold up to 32 items. Up to 16 non-recursive functions are allowed with a maximum call depth of 8."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数学、波形、補間、イージング、平滑化、ヒステリシス、エッジ、ピーク保持、再現可能な乱数、ノイズ、7グループのパターンを利用できます。型付きリストは最大32項目、非再帰関数は最大16個、呼び出し深度は8です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持数学、波形、插值、缓动、平滑、迟滞、边沿、峰值保持、可复现随机数、噪声及 7 组图案。类型列表最多 32 项；最多 16 个非递归函数，最大调用深度为 8。"
          }
        }
      }
    },
    "help.algorithms.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algorithms, Lists, and Functions"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アルゴリズム・リスト・関数"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "算法、列表与函数"
          }
        }
      }
    },
    "help.blocks.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect executable blocks below the single Start block. Light, time, variables, arithmetic, conditions, control, algorithms, lists, functions, sensors, audio, and patterns are supported. Every infinite loop and visible color change must advance time. Preview and hardware use the same interpreter; playback changes RAM only and restores the prior effect on stop or disconnect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行ブロックは唯一の開始ブロックの下へ接続します。ライト、時間、変数、演算、判定、制御、アルゴリズム、リスト、関数、センサー、音声、パターンに対応します。無限ループと色変更は必ず時間を進めます。プレビューと実機は同じインタープリターを使い、RAM のみを変更して停止・切断時に元へ戻します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可执行积木需连接在唯一的开始积木下。支持灯光、时间、变量、运算、判断、控制、算法、列表、函数、传感器、音频和图案。无限循环和颜色变化必须推进时间。预览与真机使用同一解释器；播放只修改 RAM，停止或断线后恢复原灯效。"
          }
        }
      }
    },
    "help.blocks.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Block Effect Programming"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブロック式エフェクトプログラミング"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "积木效果编程"
          }
        }
      }
    },
    "help.buttons.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap GPIO9 to change scene; hold and release it to switch BLE/Wi‑Fi. GPIO4 OFF turns the lights off and enters deep sleep. The status LED is off before BLE connects, solid when connected, slow-blinking on Wi‑Fi, and fast-blinking while switching."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPIO9 の短押しでシーン、長押し後に離すと BLE/Wi‑Fi が切り替わります。GPIO4 が OFF の場合は消灯して深くスリープします。LED は BLE 未接続時に消灯、接続時に点灯、Wi‑Fi でゆっくり点滅、切替時に速く点滅します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPIO9 短按切换场景，长按并松开切换 BLE/Wi‑Fi。GPIO4 为 OFF 时熄灯并深睡眠。BLE 未连接时状态灯熄灭，连接后常亮；Wi‑Fi 慢闪，切换时快闪。"
          }
        }
      }
    },
    "help.buttons.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buttons, Switch, and Status LED"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボタン・スイッチ・表示LED"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按键、开关和状态灯"
          }
        }
      }
    },
