{
  "sourceLanguage" : "en",
  "strings" : {
    "device.status.write.validation.passed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Scene, global LED, single-group, and seven-group writes passed read-back verification. Original values were restored." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "シーン、全体LED、単一グループ、7グループの書き込みと読み戻しに成功し、元の値へ復元しました。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "场景、全局灯光、单灯组和七灯组写入均通过回读验证，原始参数已恢复。" } }
      }
    },
    "device.validation.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Temporarily changes lighting registers, verifies them, then restores the complete original state." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ライト設定を一時変更して読み戻しを確認し、完全な元の状態へ復元します。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "临时修改灯光寄存器并回读验证，随后恢复完整原始状态。" } }
      }
    },
    "device.validation.run" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Run reversible write test" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "復元可能な書き込みテストを実行" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "运行可恢复写入测试" } }
      }
    },
    "device.validation.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Physical validation" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "実機検証" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "真机验证" } }
      }
    },
    "device.error.readback.mismatch" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The device acknowledged the change, but the value read back did not match. Refresh and try again." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "デバイスは変更を受信しましたが、読み戻した値が一致しません。更新してもう一度お試しください。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设备已确认修改，但回读值不一致。请刷新后重试。" } }
      }
    },
    "device.status.color.applied" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Support color applied and verified on the device." } },
