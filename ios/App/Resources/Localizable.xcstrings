    "help.quick.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device starts in BLE mode and can be controlled by Maurya or USB Serial. Hold GPIO9 for about 2 seconds and release to save and switch to Wi‑Fi. Join Maurya-XXXX with password Maurya123, then open 192.168.4.1 if the portal does not appear."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初回は BLE モードで、Maurya または USB Serial から操作できます。GPIO9 を約2秒長押しして離すと保存して Wi‑Fi へ切り替わります。Maurya-XXXX にパスワード Maurya123 で接続し、表示されない場合は 192.168.4.1 を開きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备首次启动默认为 BLE 模式，可使用 Maurya 或 USB Serial 操作。长按 GPIO9 约 2 秒并松开可保存并切换至 Wi‑Fi。连接 Maurya-XXXX，密码 Maurya123；未自动弹页时访问 192.168.4.1。"
          }
        }
      }
    },
    "help.quick.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First Use"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初回起動"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次使用"
          }
        }
      }
    },
    "help.recovery.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB Serial Modbus remains available in BLE and Wi‑Fi modes for diagnostics and recovery. Delayed saving and dual slots protect configuration. A production-tool full erase restores default BLE and lighting settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB Serial Modbus は BLE/Wi‑Fi の両方で診断と復旧に使えます。設定は遅延保存と二重スロットで保護され、量産ツールの全消去で初期 BLE とデフォルト灯光へ戻ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB Serial Modbus 在 BLE 和 Wi‑Fi 模式下均可用于诊断和恢复。配置采用延迟保存和双槽保护；量产工具全片擦除后会恢复默认 BLE 与默认灯效。"
          }
        }
      }
    },
    "help.recovery.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery, Saving, and Versions"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復旧・保存・バージョン"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复、保存与版本"
          }
        }
      }
    },
