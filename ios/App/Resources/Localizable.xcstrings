    "help.sensors.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programs can use motion, orientation, proximity, heading, pressure, audio level, bands, beat, and BPM. Missing required hardware prevents playback. Microphone input is analyzed at 16 kHz and is never saved or uploaded. Inputs are active only during temporary RAM playback and are released on stop."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モーション、姿勢、近接、方位、気圧、音量、帯域、ビート、BPM を参照できます。必要なハードウェアがない場合は再生しません。マイクは 16 kHz で解析するだけで保存・送信せず、RAM 一時再生中のみ有効で停止時に解除します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "程序可读取运动、姿态、接近、方向、气压、音量、频段、节拍和 BPM。缺少必需硬件时不会播放。麦克风仅以 16 kHz 分析，不保存或上传录音；输入仅在 RAM 临时播放期间启用，停止后立即释放。"
          }
        }
      }
    },
    "help.sensors.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Device Sensors and Music"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末センサーと音楽解析"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手机传感器与音乐"
          }
        }
      }
    },
