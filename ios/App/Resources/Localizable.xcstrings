    "help.safety.truthful" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unavailable hardware and services remain disabled; the app never substitutes demo success."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用できないハードウェアとサービスは無効のままにし、デモ成功で代替しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不可用的硬件和服务保持禁用，应用不会用演示成功替代。"
          }
        }
      }
    },
    "help.script.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use effect \"Name\" { ... } and end statements with semicolons. Targets are all or group(1)…group(7); use color, hsv, mode, wait, and fade. Variables, conditions, loops, and functions are supported. Code is parsed as a restricted effect language—it cannot execute JavaScript or system commands. Syntax, zero-time loops, and invisible states are checked before playback."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "effect \"名前\" { ... } を入口にし、文末にセミコロンを付けます。対象は all または group(1)…group(7)で、color、hsv、mode、wait、fade、変数、判定、ループ、関数を使えます。制限付き灯光言語のため JavaScript やシステム命令は実行せず、再生前に構文、時間の進まないループ、不可視状態を検査します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 effect \"名称\" { ... } 作为入口，语句以分号结尾。目标为 all 或 group(1)…group(7)，支持 color、hsv、mode、wait 和 fade，也支持变量、判断、循环与函数。代码是受限灯效语言，不执行 JavaScript 或系统命令；播放前会检查语法、零耗时循环和不可见状态。"
          }
        }
      }
    },
    "help.script.example" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "effect \"Red Blue Strobe\" {\n    forever {\n        all.mode(STROBE, 128);\n        all.color(\"#FF2D55\");\n        wait(2s);\n        all.color(\"#1677FF\");\n        wait(2s);\n    }\n}"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "effect \"赤青点滅\" {\n    forever {\n        all.mode(STROBE, 128);\n        all.color(\"#FF2D55\");\n        wait(2s);\n        all.color(\"#1677FF\");\n        wait(2s);\n    }\n}"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "effect \"红蓝频闪\" {\n    forever {\n        all.mode(STROBE, 128);\n        all.color(\"#FF2D55\");\n        wait(2s);\n        all.color(\"#1677FF\");\n        wait(2s);\n    }\n}"
          }
        }
      }
    },
