    "help.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connection, control, programming, and recovery guidance is available here offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続、操作、プログラミング、復旧方法をオフラインで確認できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接方法、控制流程、编程和故障恢复均可在此离线查看。"
          }
        }
      }
    },
    "help.lighting.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Device information shows temperature, voltage, address, and diagnostics. Scene controls motion and speed; global controls brightness and RGB gain. Apply steady/strobe, HSV, and speed to all groups or edit seven groups individually. Wait for the saved state before removing power."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "温度、電圧、アドレス、診断を確認できます。シーンでは動きと速度、全体照明では明るさと RGB ゲインを調整します。常時点灯/点滅、HSV、速度を全体または7グループ個別に設定できます。電源を切る前に保存済みを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备信息显示温度、电压、地址和诊断。场景控制运动与速度，全局控制亮度和 RGB 增益。可统一设置常亮/频闪、HSV 和速度，也可单独调整 7 组。断电前请等待已保存状态。"
          }
        }
      }
    },
    "help.lighting.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lighting Controls"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライトコントロール"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灯光控制"
          }
        }
      }
    },
    "help.network.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A “No Internet” warning on the device Wi‑Fi is expected; remain connected and open http://192.168.4.1/. If no IP is assigned, forget the network and restart. A manual address can use 192.168.4.2/24 with gateway and DNS 192.168.4.1. At most two clients can connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス Wi‑Fi の「インターネット接続なし」は正常です。接続を維持して http://192.168.4.1/ を開きます。IP がない場合はネットワークを削除して再起動し、手動なら 192.168.4.2/24、ゲートウェイ/DNS は 192.168.4.1 を使います。同時接続は2台までです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设备 Wi‑Fi 显示“无互联网”属于正常现象，请保持连接并访问 http://192.168.4.1/。无法获取 IP 时忘记网络并重启；手动地址可设为 192.168.4.2/24，网关和 DNS 为 192.168.4.1。最多同时连接 2 台。"
          }
        }
      }
    },
    "help.network.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connection and Troubleshooting"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続とトラブルシューティング"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接与故障排查"
          }
        }
      }
    },
    "help.offline.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Help, controls, app resources, and the character catalog do not depend on a CDN, online fonts, or an external server."
