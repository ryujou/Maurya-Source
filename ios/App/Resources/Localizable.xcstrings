    "help.palette.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search members by Chinese or Japanese name and select their HEX support color. Applying to all seven groups converts it to HSV while preserving each group’s mode and speed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中国語名または日本語名で検索し、HEX 応援色を選べます。全7グループへ適用すると HSV に変換し、各グループのモードと速度を保持します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用中文或日文名称搜索成员并选择 HEX 应援色。应用到全部 7 组时会转换为 HSV，同时保留各组模式和速度。"
          }
        }
      }
    },
    "help.palette.title" : {
      "extractionState" : "manual",
